# Desarrollo con Docker: no hace falta configurar una clave manualmente.
# La clave local se genera y conserva en el volumen development_settings.
# No copies claves reales en este archivo ni las subas a Git.
IVEM_PORT=8000
IVEM_COOKIE_SECURE=false

# Servidor con ivem_digit.settings: ambas variables son obligatorias.
# Genera la clave privadamente; no uses este texto como valor.
# IVEM_SECRET_KEY=
# IP o dominio exactos, sin http://, rutas, puertos ni comodines.
# IVEM_ALLOWED_HOSTS=203.0.113.10,ivem.example.com
