        CREATE TABLE IF NOT EXISTS oficios_delegacion_2022 (
            id SERIAL PRIMARY KEY,
            folio INTEGER UNIQUE,
            fecha_recibido DATE NOT NULL,
            fecha_oficio DATE,
            enviado_por VARCHAR(255) NOT NULL,
            procedencia VARCHAR(255) NOT NULL,
            asunto VARCHAR(255) NOT NULL,
            referencia VARCHAR(255),
            asunto_opciones VARCHAR(255),
            area VARCHAR(255),
            pendiente BOOLEAN DEFAULT TRUE,
            archivo VARCHAR(255),
            departamento VARCHAR(20) DEFAULT 'delegacion'
        );

        CREATE OR REPLACE FUNCTION set_folio_delegacion_2022()
        RETURNS TRIGGER AS $$
        BEGIN
            IF NEW.pendiente = FALSE AND NEW.folio IS NULL THEN
                NEW.folio := nextval('folio_seq_delegacion_2022');
            END IF;
            RETURN NEW;
        END;
        $$ LANGUAGE plpgsql;

        DO $$
        BEGIN
            IF NOT EXISTS (
                SELECT 1 FROM pg_trigger 
                WHERE tgname = 'trg_set_folio_delegacion_2022'
            ) THEN
                EXECUTE format('
                    CREATE TRIGGER trg_set_folio_delegacion_2022
                    BEFORE INSERT OR UPDATE ON %I
                    FOR EACH ROW EXECUTE FUNCTION set_folio_delegacion_2022()',
                    'oficios_delegacion_2022'
                );
            END IF;
        END $$;
        ; args=None; alias=default
